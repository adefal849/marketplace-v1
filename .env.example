# Base de données (Neon ou Supabase - tier gratuit)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT
JWT_SECRET="change-moi-en-une-longue-chaine-aleatoire"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Upload direct navigateur → Cloudinary (photos/vidéos produits) :
# nécessite un "unsigned upload preset" créé dans Cloudinary > Settings > Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Assistant IA boutique (Groq — console.groq.com)
GROQ_API_KEY=""

# Email de réinitialisation de mot de passe (Resend — resend.com)
RESEND_API_KEY=""
RESEND_FROM=""

# Connexion Google (console.cloud.google.com > APIs & Services > Credentials
# > Create OAuth client ID > Web application > ajoute l'URL de ton site dans
# "Authorized JavaScript origins")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
